# Hermes Laya Tools - Environment Configuration
# Place these variables in your Hermes .env file (~/.hermes/.env)

# URL to Laya System 1 Decision Engine REST API (/ask, /health)
LAYA_URL=http://127.0.0.1:8787

# Mode: 'active' (modifies tool surface for LLM) or 'shadow' (only logs, 0 impact on main LLM)
LAYA_MODE=shadow

# Plugin master switch (true/false)
LAYA_ENABLED=true

# Enable two-level hierarchical routing (category selection -> top-10 tools)
LAYA_HIERARCHICAL=true

# Maximum number of tools passed to the main model
LAYA_MAX_TOOLS=10

# Request timeout in milliseconds
LAYA_TIMEOUT_MS=5000

# Daily categorization interval (24 hours = 86400000 ms)
LAYA_CATEGORIZATION_INTERVAL_MS=86400000

# Path to cached categories JSON file
LAYA_CACHE_PATH=/root/.hermes/cache/laya_categories.json

# Tools guaranteed to be included in candidate list (comma-separated)
# LAYA_ALWAYS_INCLUDE=request_toolset

# Fallback mode when Laya is unreachable ('pass-all' or 'strip-all')
LAYA_FALLBACK_MODE=pass-all

# Output System 1 decision notices in chat log (ignored and forced false in shadow mode)
LAYA_NOTIFY_IN_CHAT=false

# Structured JSONL audit log of all Laya requests and responses
LAYA_LOG_PATH=/root/.hermes/logs/laya_requests.jsonl

# Logging level (DEBUG, INFO, WARNING, ERROR)
LAYA_LOG_LEVEL=INFO
